# Настройки конкретного хостинга. Скопируйте в deploy/hosting.env и заполните на сервере.
# hosting.env в Git не попадает: паролей и данных хостинга в репозитории нет.
# Значения без кавычек и пробелов.

# Адрес сайта и папка сайта на сервере
SITE_URL=https://example.ru
WEB_ROOT=/home/USER/domains/example.ru/public_html

# База данных (создаётся в панели хостинга заранее)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# Вход в админку (придумайте новый пароль)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Куда приходят копии заявок (через запятую, без пробелов)
NOTIFY_EMAILS=

# Почта для отправки (ящик создаётся в панели хостинга заранее).
# Если SMTP_HOST пустой, письма идут через mail() хостинга.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASSWORD=

# production — боевой сайт (Метрика включена), staging — запасной или тестовый
ENVIRONMENT=production
# 1 — открыть сайт поисковикам, 0 — закрыть
INDEXING=1

# Версия WordPress и путь к PHP на хостинге
WP_VERSION=7.1.3
PHP_BIN=php
