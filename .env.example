# Скопируйте в .env и задайте свои пароли. Файл .env в репозиторий не попадает.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Порт, на котором откроется сайт: http://localhost:8080
WP_PORT=8080
WP_URL=http://localhost:8080
WP_DEBUG=1

# Учётная запись администратора, создаётся скриптом установки
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@example.com
